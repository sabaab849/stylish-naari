{
  "_notes": {
    "source": "Every value here comes from content already in the project: the homepage product cards, brand-guidelines.md (§5.2 image inventory, §15.5 product naming, §9.4 content colours) and the photographs themselves.",
    "price": "Prices are the homepage PLACEHOLDERS (priceIsPlaceholder: true). Bagh has no price anywhere in the project, so it is null and cannot be added to the bag. Replace with real prices before launch.",
    "description": "descriptionStatus 'guideline' = text from brand-guidelines.md. 'draft' = a sentence assembled only from documented visual attributes (colour, border, motif). Approve or rewrite before launch.",
    "nulls": "null = not documented anywhere yet. The PDP hides any row or section whose data is null. Nothing is invented to fill gaps.",
    "crops": "Crops are zooms of the existing photos (s = scale, ox/oy = focal point, op = object-position). They stand in for dedicated drape and macro photography, which hasn't been shot yet.",
    "secondShoot": "Sarees 05–12 come from the second shoot (model photography folder). Their names are PROPOSALS in the same convention as the first four. Fabric is stated only where the photograph filename states it (silk, brocade); border and motif describe what is visible in the photographs. Prices are null: none have been supplied.",
    "focus": "images[].pos / images[].focus frame each photograph in the 3:4 gallery and card frame. The whole figure stays in frame; zoom is used only where the model is small in the photo.",
    "styling": "styling = one line listing only what is visible in the saree's own portrait (hair, jewellery, blouse). stylingStatus 'draft': approve or rewrite before launch. null hides the 'As styled' feature on the PDP. crops.styling frames that part of the portrait.",
    "backdrop": "backdrop = the photograph behind 'The Saree, Unfolded' on the PDP. img = which of the saree's own images; pos / posMobile = object-position on desktop / phone; wide = an optional landscape file of the same saree, used from tablet up.",
    "closer": "product.closer drives the \"A closer look\" section: a per-saree heading (draft copy) and up to three attribute pairs drawn from that saree's attributes. Without it the section falls back to the attributes directly."
  },
  "store": {
