{%- comment -%}
  Texture banner — "Texture first": one close-up photograph, edge to edge, with the words set into it (Stylish Naari).
  The Shopify version of homepage/render/texture-banner.mjs + the "Texture banner" block in homepage.css.
  Keep the two in step.

  Self-contained on purpose: the styles live in this file, every design token has a fallback, and nothing
  depends on a class on <html> or on a theme script. Copy this one file into the theme's sections/ folder
  and add "Texture banner" from the theme editor.

  There is no JavaScript. The only movement is the link's underline and arrow on hover, and
  prefers-reduced-motion switches that off.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign link_url = section.settings.link
  assign image_style = image.presentation.focal_point | prepend: 'object-position: '
  assign image_mobile_style = image_mobile.presentation.focal_point | prepend: 'object-position: '
-%}

<div
  class="sn-texture"
  aria-labelledby="sn-texture-title-{{ section.id }}"
  role="region"
  style="--shade: {{ section.settings.shade.red }}, {{ section.settings.shade.green }}, {{ section.settings.shade.blue }}; --ink: {{ section.settings.text_color }};"
>
  <div class="sn-texture__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'sn-texture__img sn-texture__img--wide',
          widths: '1100, 1500, 2000, 2400',
          sizes: '100vw',
          style: image_style
      }}
      {{
        image_mobile
        | image_url: width: 1500
        | image_tag:
          loading: 'lazy',
          class: 'sn-texture__img sn-texture__img--narrow',
          widths: '500, 750, 1100, 1500',
          sizes: '100vw',
          alt: '',
          style: image_mobile_style
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'sn-texture__placeholder' }}
    {%- endif -%}
  </div>
  <div class="sn-texture__scrim" aria-hidden="true"></div>

  <div class="sn-texture__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sn-texture__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="sn-texture__title" id="sn-texture-title-{{ section.id }}">
      {%- if link_url != blank -%}
        <a class="sn-texture__link" href="{{ link_url }}">{{ section.settings.heading | escape }}</a>
      {%- else -%}
        {{ section.settings.heading | escape }}
      {%- endif -%}
    </h2>
    {%- if section.settings.text != blank -%}
      <p class="sn-texture__line">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if link_url != blank and section.settings.link_label != blank -%}
      <span class="sn-texture__cta" aria-hidden="true">
        <span class="sn-texture__cta-label">{{ section.settings.link_label | escape }}</span>
        <span class="sn-texture__cta-arrow">↗</span>
      </span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sn-texture {
    --sn-ivory: var(--color-ivory, #F6F1EA);
    --sn-margin: var(--page-margin, clamp(16px, 3.4vw, 48px));
    --sn-display: var(--font-display, "Inter Tight", "Helvetica Neue", Arial, sans-serif);
    --sn-ease: var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
    position: relative; isolation: isolate; overflow: hidden;
    aspect-ratio: 2.8 / 1; min-height: 460px; max-height: 88svh;
    background: rgb(var(--shade, 8, 17, 13)); color: var(--ink, var(--sn-ivory));
  }
  .sn-texture p, .sn-texture h2 { margin: 0; }

  .sn-texture__media { position: absolute; inset: 0; }
  /* Each image is cropped around the focal point set on it in the theme editor */
  .sn-texture__img, .sn-texture__placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sn-texture__img--narrow { display: none; }
  /* A shade in the photograph's own dark tone: solid under the words, clear by the middle of the picture */
  .sn-texture__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgba(var(--shade), 0.9) 0%, rgba(var(--shade), 0.72) 22%, rgba(var(--shade), 0.3) 42%, rgba(var(--shade), 0) 58%),
      linear-gradient(to top, rgba(var(--shade), 0.35) 0%, rgba(var(--shade), 0) 40%);
  }

  .sn-texture__content {
    position: absolute; left: 0; right: 0; bottom: clamp(40px, 4.5vw, 64px); z-index: 1;
    padding: 0 var(--sn-margin);
  }
  .sn-texture__eyebrow {
    margin-bottom: 24px; opacity: 0.78;
    font-family: var(--sn-display); font-weight: 500; font-size: 12px; line-height: 1.2;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .sn-texture__title {
    max-width: 9em;
    font-family: var(--sn-display); font-weight: 400;
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.75rem);
    line-height: 1; letter-spacing: -0.03em;
  }
  .sn-texture__link { color: inherit; text-decoration: none; }
  /* The whole section is the link; keyboard focus rings the section, not the headline */
  .sn-texture__link::after { content: ""; position: absolute; inset: -200vh -100vw; z-index: 1; }
  .sn-texture__link:focus-visible { outline: none; }
  .sn-texture:has(.sn-texture__link:focus-visible) { outline: 2px solid var(--sn-ivory); outline-offset: -8px; }
  .sn-texture__line { margin-top: 12px; max-width: 22em; font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.5rem); line-height: 1.3; }
  .sn-texture__cta {
    display: inline-flex; align-items: baseline; gap: 8px; margin-top: clamp(32px, 4vw, 64px);
    font-family: var(--sn-display); font-weight: 500; font-size: 15px;
  }
  .sn-texture__cta-label {
    padding-bottom: 4px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 400ms var(--sn-ease);
  }
  .sn-texture__cta-arrow { display: inline-block; transition: transform 400ms var(--sn-ease); }
  .sn-texture:hover .sn-texture__cta-label, .sn-texture:focus-within .sn-texture__cta-label { background-size: 100% 1px; }
  .sn-texture:hover .sn-texture__cta-arrow, .sn-texture:focus-within .sn-texture__cta-arrow { transform: translate(3px, -3px); }
  @media (prefers-reduced-motion: reduce) {
    .sn-texture__cta-label, .sn-texture__cta-arrow { transition: none; }
    .sn-texture:hover .sn-texture__cta-arrow, .sn-texture:focus-within .sn-texture__cta-arrow { transform: none; }
  }

  /* Tablet: a taller frame, and the shade reaches further across so the headline keeps its room */
  @media (max-width: 1023px) {
    .sn-texture { aspect-ratio: 16 / 9; min-height: 420px; }
    .sn-texture__scrim {
      background:
        linear-gradient(to right, rgba(var(--shade), 0.9) 0%, rgba(var(--shade), 0.66) 34%, rgba(var(--shade), 0) 76%),
        linear-gradient(to top, rgba(var(--shade), 0.45) 0%, rgba(var(--shade), 0) 50%);
    }
  }
  /* Phone: a portrait frame with its own image; the words sit at the foot, on a shade from below */
  @media (max-width: 767px) {
    .sn-texture { aspect-ratio: 4 / 5; min-height: 0; max-height: none; }
    .sn-texture__img--wide { display: none; }
    .sn-texture__img--narrow { display: block; }
    .sn-texture__scrim {
      background: linear-gradient(to top, rgba(var(--shade), 0.94) 0%, rgba(var(--shade), 0.78) 30%, rgba(var(--shade), 0) 62%);
    }
    .sn-texture__content { bottom: 40px; }
    .sn-texture__eyebrow { margin-bottom: 12px; }
    .sn-texture__title { font-size: clamp(2.125rem, 9.5vw, 2.75rem); }
    .sn-texture__cta { margin-top: 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Texture banner",
  "tag": "section",
  "class": "section-texture-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph", "info": "A close-up of the fabric. Set the focal point on the image to choose the band the wide banner shows." },
    { "type": "image_picker", "id": "image_mobile", "label": "Photograph on phones", "info": "Optional. A portrait crop; the main photograph is used when this is empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Texture first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "An art of its own." },
    { "type": "text", "id": "text", "label": "Text", "default": "Every weave has a story." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the collection" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "shade", "label": "Shade behind the text", "default": "#08110D", "info": "Use the darkest tone in the photograph." },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F6F1EA" }
  ],
  "presets": [{ "name": "Texture banner" }]
}
{% endschema %}
